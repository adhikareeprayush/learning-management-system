generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SubmissionStatus {
  PENDING
  GRADED
  SUBMITTED
}

enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum PlatformRole {
  SUPER_ADMIN
}

enum OrgRole {
  ORG_ADMIN
  INSTRUCTOR
  STUDENT
}

enum OrgStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELED
  EXPIRED
  REFUNDED
}

enum PaymentMethodType {
  ESEWA
  MOBILE_BANKING
  KHALTI_QR
}

enum NewsletterSubscriberStatus {
  ACTIVE
  UNSUBSCRIBED
}

enum NewsletterCampaignStatus {
  DRAFT
  SENDING
  SENT
}

enum NewsletterDeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED
}

enum LessonResourceType {
  VIDEO
  TEXT
  EXERCISE
  QUIZ
}

enum RoadmapStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Institute (single default org)

model Plan {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  description   String?
  priceNpr      Int      @default(0)
  billingPeriod String   @default("monthly")
  limits        Json     @default("{}")
  features      Json     @default("{}")
  isPublic      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organizations Organization[]
  subscriptions OrganizationSubscription[]

  @@map("plans")
}

model Organization {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  subdomain String    @unique
  status    OrgStatus @default(PENDING)
  branding  Json      @default("{}")
  settings  Json      @default("{}")
  planId    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  plan                  Plan?                     @relation(fields: [planId], references: [id], onDelete: SetNull)
  subscription          OrganizationSubscription?
  members               OrganizationMember[]
  courses               Course[]
  roadmaps              Roadmap[]
  paymentMethods        PaymentMethod[]
  newsletterSubscribers NewsletterSubscriber[]
  newsletterCampaigns   NewsletterCampaign[]
  contactMessages       ContactMessage[]

  @@map("organizations")
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole  @default(STUDENT)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model OrganizationSubscription {
  id                 String             @id @default(cuid())
  organizationId     String             @unique
  planId             String
  status             SubscriptionStatus @default(TRIAL)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan                  @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments     SubscriptionPayment[]

  @@map("organization_subscriptions")
}

model SubscriptionPayment {
  id              String        @id @default(cuid())
  subscriptionId  String
  purchaseOrderId String        @unique
  amount          Int
  status          PaymentStatus @default(PENDING)
  screenshotUrl   String?
  referenceNote   String?
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  completedAt     DateTime?

  subscription OrganizationSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  reviewedBy   User?                    @relation("SubscriptionPaymentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([subscriptionId])
  @@index([status])
  @@map("subscription_payments")
}

model PlatformPaymentMethod {
  id           String            @id @default(cuid())
  type         PaymentMethodType
  label        String
  accountInfo  String
  instructions String?
  qrImageUrl   String?
  enabled      Boolean           @default(true)
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@map("platform_payment_methods")
}

// ─── BetterAuth ─────────────────────────────────────────────────────────────

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  emailVerified Boolean       @default(false)
  name          String
  image         String?
  role          Role          @default(STUDENT)
  platformRole  PlatformRole?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  bio         String?
  preferences Json    @default("{}")

  disabledAt     DateTime?
  disabledReason String?
  deletedAt      DateTime?

  sessions                     Session[]
  accounts                     Account[]
  lessonProgress               LessonProgress[]
  submissions                  Submission[]
  courseTeaching               Course[]              @relation("InstructorCourses")
  enrollments                  Enrollment[]
  reviews                      Review[]
  certificates                 Certificate[]
  resourceAttempts             ResourceAttempt[]
  roadmapEnrollments           RoadmapEnrollment[]
  roadmapCertificates          RoadmapCertificate[]
  payments                     Payment[]
  paymentsReviewed             Payment[]             @relation("PaymentReviewer")
  newsletterCampaigns          NewsletterCampaign[]
  organizationMembers          OrganizationMember[]
  subscriptionPaymentsReviewed SubscriptionPayment[] @relation("SubscriptionPaymentReviewer")

  @@index([createdAt])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// better-auth rate limiting (rateLimit.storage = "database"); rows expire quickly.
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limits")
}

// ─── LMS models (tenant-scoped) ─────────────────────────────────────────────

model Course {
  id             String       @id @default(cuid())
  organizationId String
  title          String
  description    String?
  thumbnail      String?
  category       String?
  instructorId   String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  price          Int          @default(0)
  priceNpr       Int          @default(0)
  level          Level        @default(BEGINNER)
  featured       Boolean      @default(false)
  slug           String
  status         CourseStatus @default(DRAFT)
  duration       Int          @default(0)
  outcomes       String[]
  /// Latest moderation note from an admin (e.g. why it was returned to draft).
  reviewNote     String?
  reviewedAt     DateTime?

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instructor     User            @relation("InstructorCourses", fields: [instructorId], references: [id], onDelete: Restrict)
  modules        Module[]
  lessons        Lesson[]
  enrollments    Enrollment[]
  assignments    Assignment[]
  reviews        Review[]
  certificates   Certificate[]
  roadmapCourses RoadmapCourse[]
  payments       Payment[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@index([instructorId])
  @@map("courses")
}

model PaymentMethod {
  id             String            @id @default(cuid())
  organizationId String
  type           PaymentMethodType
  label          String
  accountInfo    String
  instructions   String?
  qrImageUrl     String?
  enabled        Boolean           @default(true)
  sortOrder      Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payments     Payment[]

  @@index([organizationId])
  @@map("payment_methods")
}

model Payment {
  id              String             @id @default(cuid())
  userId          String
  courseId        String
  paymentMethodId String?
  purchaseOrderId String             @unique
  methodType      PaymentMethodType?
  amount          Int
  status          PaymentStatus      @default(PENDING)
  screenshotUrl   String?
  referenceNote   String?
  transactionId   String?
  rejectionReason String?
  metadata        Json?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  completedAt     DateTime?

  // Payments are financial records: block deleting their user or course.
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  course        Course         @relation(fields: [courseId], references: [id], onDelete: Restrict)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  reviewedBy    User?          @relation("PaymentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId, courseId])
  @@index([courseId, status])
  @@index([status, createdAt])
  @@map("payments")
}

model NewsletterSubscriber {
  id             String                     @id @default(cuid())
  organizationId String
  email          String
  name           String?
  status         NewsletterSubscriberStatus @default(ACTIVE)
  source         String                     @default("footer")
  subscribedAt   DateTime                   @default(now())
  unsubscribedAt DateTime?

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   NewsletterDelivery[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("newsletter_subscribers")
}

model NewsletterCampaign {
  id             String                   @id @default(cuid())
  organizationId String
  subject        String
  body           String
  status         NewsletterCampaignStatus @default(DRAFT)
  startedAt      DateTime?
  sentAt         DateTime?
  recipientCount Int                      @default(0)
  failedCount    Int                      @default(0)
  createdById    String
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User                 @relation(fields: [createdById], references: [id], onDelete: Cascade)
  deliveries   NewsletterDelivery[]

  @@index([organizationId])
  @@index([createdById])
  @@map("newsletter_campaigns")
}

model NewsletterDelivery {
  id           String                   @id @default(cuid())
  campaignId   String
  subscriberId String?
  email        String
  status       NewsletterDeliveryStatus @default(PENDING)
  attempts     Int                      @default(0)
  error        String?
  claimedAt    DateTime?
  sentAt       DateTime?
  createdAt    DateTime                 @default(now())

  campaign   NewsletterCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriber NewsletterSubscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)

  @@unique([campaignId, email])
  @@index([campaignId, status])
  @@map("newsletter_deliveries")
}

model ContactMessage {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  name           String
  email          String
  topic          String
  message        String
  ipHash         String?
  userAgent      String?
  /// PENDING, SENT, LOGGED or FAILED
  emailStatus    String   @default("PENDING")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([ipHash, createdAt])
  @@index([email, createdAt])
  @@map("contact_messages")
}

model LessonResource {
  id          String             @id @default(cuid())
  lessonId    String
  type        LessonResourceType @default(TEXT)
  url         String
  title       String
  description String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  lesson   Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  attempts ResourceAttempt[]

  @@index([lessonId])
  @@map("lesson_resources")
}

model Lesson {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  content   String?
  videoUrl  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  duration  Int      @default(0)
  isFree    Boolean  @default(false)
  summary   String?
  moduleId  String?

  resources LessonResource[]
  module    Module?          @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress  LessonProgress[]

  @@unique([courseId, order])
  @@index([courseId])
  @@index([moduleId])
  @@map("lessons")
}

model Module {
  id          String  @id @default(cuid())
  courseId    String
  title       String
  description String?
  order       Int     @default(0)

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([courseId, order])
  @@map("modules")
}

model Enrollment {
  id         String   @id @default(cuid())
  courseId   String
  studentId  String
  progress   Float    @default(0.0)
  enrolledAt DateTime @default(now())

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@index([studentId, enrolledAt])
  @@map("enrollments")
}

model LessonProgress {
  id          String    @id @default(cuid())
  studentId   String
  lessonId    String
  completed   Boolean   @default(false)
  completedAt DateTime?

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson  Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  @@index([lessonId])
  @@index([studentId, completed, completedAt])
  @@map("lesson_progress")
}

model Assignment {
  id          String    @id @default(cuid())
  courseId    String
  title       String
  description String?
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@index([courseId, dueDate])
  @@map("assignments")
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  studentId    String
  content      String?
  fileUrl      String?
  status       SubmissionStatus @default(PENDING)
  grade        Float?
  feedback     String?
  submittedAt  DateTime         @default(now())
  gradedAt     DateTime?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@map("submissions")
}

model Review {
  id        String   @id @default(cuid())
  courseId  String
  studentId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@index([courseId, createdAt])
  @@map("reviews")
}

model Certificate {
  id             String   @id @default(cuid())
  studentId      String
  courseId       String
  credentialId   String   @unique @default(cuid())
  issuedAt       DateTime @default(now())
  // Snapshot at issue time so later renames don't rewrite an issued credential.
  holderName     String?
  courseTitle    String?
  instructorName String?

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([studentId, courseId])
  @@index([courseId])
  @@map("certificates")
}

model ResourceAttempt {
  id         String   @id @default(cuid())
  studentId  String
  resourceId String
  score      Float
  passed     Boolean  @default(false)
  answers    Json     @default("[]")
  createdAt  DateTime @default(now())

  student  User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  resource LessonResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([resourceId])
  @@map("resource_attempts")
}

model Roadmap {
  id             String        @id @default(cuid())
  organizationId String
  title          String
  slug           String
  description    String?
  thumbnail      String?
  category       String?
  level          Level         @default(BEGINNER)
  status         RoadmapStatus @default(DRAFT)
  outcomes       String[]
  estimatedHours Int           @default(0)
  featured       Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  courses      RoadmapCourse[]
  enrollments  RoadmapEnrollment[]
  certificates RoadmapCertificate[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@map("roadmaps")
}

model RoadmapCourse {
  id        String @id @default(cuid())
  roadmapId String
  courseId  String
  order     Int    @default(0)

  roadmap Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([roadmapId, courseId])
  @@unique([roadmapId, order])
  @@index([courseId])
  @@map("roadmap_courses")
}

model RoadmapEnrollment {
  id         String   @id @default(cuid())
  roadmapId  String
  studentId  String
  progress   Float    @default(0.0)
  enrolledAt DateTime @default(now())

  roadmap Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([roadmapId, studentId])
  @@index([studentId])
  @@map("roadmap_enrollments")
}

model RoadmapCertificate {
  id           String   @id @default(cuid())
  studentId    String
  roadmapId    String
  credentialId String   @unique @default(cuid())
  issuedAt     DateTime @default(now())
  // Snapshot at issue time (see Certificate).
  holderName   String?
  roadmapTitle String?
  courseCount  Int?

  student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  roadmap Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@unique([studentId, roadmapId])
  @@index([roadmapId])
  @@map("roadmap_certificates")
}
