# Local development — Docker Postgres (optional)
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/lms

# Supabase (production on Vercel)
# Runtime (serverless) — Transaction pooler, port 6543:
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Migrations (local/CI only) — Direct or Session pooler, port 5432:
# DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# Local dev can use the direct host db.[ref].supabase.co:5432 for both.

# Optional: default institute slug (seed creates "edujarr")
# DEFAULT_ORG_SLUG=edujarr

BETTER_AUTH_SECRET=docker-dev-secret-change-me-32chars
BETTER_AUTH_URL=http://localhost:3005
NEXT_PUBLIC_APP_URL=http://localhost:3005
# BETTER_AUTH_TRUSTED_ORIGINS=https://your-production-domain.com

# Production images do not seed automatically. Enable only for disposable/demo data.
SEED_DATABASE_ON_START=false

# Media uploads (server-only; never prefix private values with NEXT_PUBLIC_)
IMAGEKIT_PUBLIC_KEY=public_your_key
IMAGEKIT_PRIVATE_KEY=private_your_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
IMAGEKIT_MAX_UPLOAD_MB=25

# YouTube Data API v3 — instructor lesson video uploads (server-only)
# 1. Enable YouTube Data API v3 in Google Cloud
# 2. OAuth client (Web) with redirect: http://localhost:8765/oauth2callback
# 3. Publish OAuth consent screen to Production (Testing tokens expire in 7 days)
# 4. Run: pnpm youtube:setup  → paste YOUTUBE_REFRESH_TOKEN into Vercel env too
# Production uploads go browser → YouTube directly (not through Vercel body limits).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_MAX_UPLOAD_MB=500
