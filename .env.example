# Copy to .env and fill in. Validated at server start (src/env.ts): missing
# required values stop a production server; development only warns.

# ─── Database (required) ──────────────────────────────────────────
# Local development — Docker Postgres (`pnpm docker:up`)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5435/lms
# Optional: max Postgres connections per server instance (default 10, or 3 on Vercel)
# DB_POOL_MAX=10

# Supabase (Vercel / remote)
# Do NOT use db.[ref].supabase.co:5432 from IPv4-only networks — that host is
# often IPv6-only and fails with EHOSTUNREACH. Use the Dashboard pooler URIs:
# the app queries through the transaction pooler (:6543) ...
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# ... and Prisma migrations use DIRECT_URL (session pooler :5432) when it is set.
# DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Optional: slug of the institute the app serves (default "convolution-labs")
# DEFAULT_ORG_SLUG=convolution-labs

# ─── Auth (required) ──────────────────────────────────────────────
# Production needs a random value of 32+ chars: `openssl rand -base64 32`.
# It also signs newsletter unsubscribe links — rotating it breaks the links in
# newsletters that were already sent.
BETTER_AUTH_SECRET=docker-dev-secret-change-me-32chars
# Public URL of the app (no trailing slash). NEXT_PUBLIC_APP_URL is compiled
# into the client bundle, so changing it needs a rebuild.
BETTER_AUTH_URL=http://localhost:3005
NEXT_PUBLIC_APP_URL=http://localhost:3005
# Extra origins allowed to call the auth API, comma-separated
# BETTER_AUTH_TRUSTED_ORIGINS=https://www.your-domain.com
# true: new accounts must confirm their email before signing in. Only enforced
# when email can actually be sent (SMTP configured, or console mode in dev).
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# ─── Demo mode & seeding ──────────────────────────────────────────
# true only for demo deployments: shows the demo accounts on the login page and
# FAQ. Compiled into the client bundle (rebuild after changing).
NEXT_PUBLIC_DEMO_MODE=false
# `pnpm db:seed` creates demo users (password "password123"), courses and
# payments. With NODE_ENV=production it refuses unless SEED_DEMO=true.
SEED_DEMO=false
# Docker only: run the demo seed on container start (also needs SEED_DEMO=true).
SEED_DATABASE_ON_START=false

# ─── First admin (`pnpm admin:create`, or Docker entrypoint) ──────
# Creates the institute if missing and an admin with these credentials.
# Existing accounts are left alone unless you pass --reset-password.
# Remove ADMIN_PASSWORD from the environment once the account exists.
# ADMIN_EMAIL=admin@your-domain.com
# ADMIN_PASSWORD=at-least-12-characters
# ADMIN_NAME="Site Admin"

# ─── Media uploads: ImageKit (required in production for uploads) ─
# Browsers upload straight to ImageKit with one-time signatures from
# /api/upload/imagekit-auth; never prefix the private key with NEXT_PUBLIC_.
# The URL endpoint is also read at BUILD time (CSP img-src, client URLs).
IMAGEKIT_PUBLIC_KEY=public_your_key
IMAGEKIT_PRIVATE_KEY=private_your_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
IMAGEKIT_MAX_UPLOAD_MB=25

# ─── Lesson videos: YouTube Data API v3 (server-only) ─────────────
# 1. Enable YouTube Data API v3 in Google Cloud
# 2. OAuth client (Web) with redirect: http://localhost:8765/oauth2callback
# 3. Publish OAuth consent screen to Production (Testing tokens expire in 7 days)
# 4. Run: pnpm youtube:setup  → paste YOUTUBE_REFRESH_TOKEN into Vercel env too
# Production uploads go browser → YouTube directly (not through Vercel body limits).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_MAX_UPLOAD_MB=500

# ─── Email (optional, recommended in production) ──────────────────
# Without SMTP_HOST, development prints emails (subject, links, text) to the
# `pnpm dev` console and production skips sending (no password resets!).
# Local inbox: `pnpm docker:mail`, then SMTP_HOST=127.0.0.1 SMTP_PORT=1025 and
# open http://localhost:8025. Check a real server with `pnpm email:test you@example.com`.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Convolution LMS <no-reply@your-domain.com>"
# Force console output even with SMTP set (never in production: logs contain reset links)
# EMAIL_TRANSPORT=console
# Contact form recipient; defaults to the institute's support email (Admin →
# Settings). In production the form is disabled when there is no recipient or
# email is not configured.
# CONTACT_FORM_TO=hello@your-domain.com
# Newsletter emails sent per batch request (default 25, max 200)
# NEWSLETTER_BATCH_SIZE=25
