{
  "name": "lms-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--dns-result-order=ipv4first' next dev --port 3005",
    "build": "next build --webpack",
    "vercel-build": "prisma generate && next build --webpack",
    "start": "next start --port 3005",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "NODE_OPTIONS='--dns-result-order=ipv4first' tsx seed.ts",
    "db:studio": "prisma studio",
    "assets:sync-imagekit": "tsx scripts/sync-imagekit-assets.ts",
    "imagekit:verify": "tsx scripts/verify-imagekit.ts",
    "youtube:verify": "tsx scripts/verify-youtube.ts",
    "youtube:setup": "tsx scripts/youtube-oauth-setup.ts",
    "docker:up": "docker compose up -d db",
    "docker:web": "docker compose up -d web",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f db",
    "docker:dev": "docker compose up -d db && pnpm db:migrate:deploy && pnpm db:seed && pnpm dev"
  },
  "prisma": {
    "seed": "tsx seed.ts"
  },
  "dependencies": {
    "@fontsource/rowdies": "^5.2.5",
    "@fontsource/saira": "^5.2.5",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "apexcharts": "^6.5.0",
    "better-auth": "^1.6.25",
    "dotenv": "^17.4.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-apexcharts": "^2.1.1",
    "react-dom": "19.2.4",
    "react-player": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prisma": "^7.9.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
